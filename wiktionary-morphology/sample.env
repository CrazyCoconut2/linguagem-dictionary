# Copy to `.env` and fill in your values:
#   cp sample.env .env
#
# D1 deploy uses wrangler in the parent linguagem-dictionary-api
# (npm run deploy:d1). Log in once from the API root:
#   npx wrangler login
#
# Optional override if wrangler.toml is not in the parent:
# DICTIONARY_API_DIR=

# Optional Cloudflare token instead of `wrangler login`:
# CLOUDFLARE_API_TOKEN=
