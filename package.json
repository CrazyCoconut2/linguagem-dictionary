{
  "name": "linguagem-dictionary-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "import:local": "node scripts/import-pack.mjs --local",
    "import:remote": "node scripts/import-pack.mjs --remote",
    "deploy:d1": "npm --prefix wiktionary-morphology run deploy:d1",
    "deploy:d1:en": "npm --prefix wiktionary-morphology run deploy:d1:en",
    "deploy:d1:all": "npm --prefix wiktionary-morphology run deploy:d1:all"
  },
  "dependencies": {
    "learner": "file:../linguagem-app/packages/learner"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "typescript": "^5.8.3",
    "wrangler": "^4.20.0"
  }
}
